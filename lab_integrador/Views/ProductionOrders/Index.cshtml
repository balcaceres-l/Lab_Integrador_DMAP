@model IEnumerable<lab_integrador.Models.ProductionOrder>

@{
    ViewData["Title"] = "Órdenes de Producción";
}

<h1>Órdenes de Producción</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Orden</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Fecha de Orden</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            "Completada" => "bg-success",
                            "Pendiente" => "bg-secondary",
                            "Sin procesos" => "bg-dark",
                            _ => "bg-warning text-dark"
                        };
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalle</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>