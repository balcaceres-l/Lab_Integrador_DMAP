@model lab_integrador.Models.ProductionOrderViewModel

@{
    ViewData["Title"] = "Nueva Orden de Producción";
}

<h1>Nueva Orden de Producción</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ProductName" class="form-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OrderDate" class="form-label"></label>
                <input asp-for="OrderDate" class="form-control" />
                <span asp-validation-for="OrderDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Procesos de fabricación</label>
                <span asp-validation-for="SelectedProcessIds" class="text-danger d-block"></span>

                @if (!Model.AvailableProcesses.Any())
                {
                    <p class="text-muted">
                        No hay procesos de fabricación registrados.
                        <a asp-controller="ManufacturingProcesses" asp-action="Create">Crea uno primero</a>.
                    </p>
                }
                else
                {
                    <div class="border rounded p-3">
                        @for (int i = 0; i < Model.AvailableProcesses.Count; i++)
                        {
                            <div class="form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       name="SelectedProcessIds"
                                       value="@Model.AvailableProcesses[i].ProcessId"
                                       id="process_@Model.AvailableProcesses[i].ProcessId"
                                       checked="@Model.AvailableProcesses[i].IsSelected" />
                                <label class="form-check-label" for="process_@Model.AvailableProcesses[i].ProcessId">
                                    @Model.AvailableProcesses[i].Name
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}